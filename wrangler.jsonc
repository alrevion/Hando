{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hando",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "hando.alrevion.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hando-db",
      // ЗАПОЛНИТЬ перед первым деплоем:
      //   wrangler d1 create hando-db
      // и подставить сюда выданный id. Пока стоит заглушка -- деплой упадёт
      // громко, и это намеренно: с id базы Sayn он писал бы в её прод.
      "database_id": "REPLACE_ME_RUN_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // ADR-4: долговечная копия вложений, ключ <org_id>/<attachment_id>.
      // Создать: wrangler r2 bucket create hando-attachments
      "binding": "ATTACHMENTS",
      "bucket_name": "hando-attachments"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "AUTH_API_URL": "https://api.auth.alrevion.com",
    // Выделенная bot-only группа Telegram под вложения. Бот @hando_ai_bot
    // уже добавлен в неё. Валидируется через resolveChatId при настройке.
    "TELEGRAM_STORAGE_CHAT_ID": "-5572663778",
    // Пусто до создания первого пользователя в базе Hando: id из базы Sayn
    // здесь бессмысленен. MCP не заработает, пока не заполнено -- см. mcp.ts:64.
    "MCP_USER_ID": ""
  }
}
