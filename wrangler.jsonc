{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hando",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "hando.alrevion.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hando-db",
      // Своя база Hando (регион EEUR), создана 2026-09-04. НЕ база Sayn:
      // с её id деплой отсюда писал бы в чужой прод.
      "database_id": "012f0c7a-2852-448c-a7dc-f615000e556d",
      "migrations_dir": "migrations"
    }
  ],
  // Слот занят ценой Sayn. Все 5 бесплатных cron-триггеров Workers Free заняты
  // (ошибка 10072 при первом деплое); 2026-09-04 владелец снял cron у Sayn и отдал
  // слот сюда -- см. комментарий в Sayn/wrangler.jsonc. Остальные четыре заняты:
  // api-push (* * * * *), api-pms (*/5), stomiko-api (*/15), telegram-otp (*/15).
  // Отсюда следствие: добавить cron ЛЮБОМУ следующему воркеру теперь нельзя без
  // Workers Paid (лимит 250).
  "triggers": {
    // Раз в час, а не каждые 5 минут. Здесь только развозка напоминаний,
    // эскалация и страховка за очередь: сами уведомления роуты и бот сливают
    // сразу после действия, поэтому частый тик ничего не ускорял -- только
    // будил людей чаще, чем нужно.
    "crons": ["0 * * * *"]
  },
  "vars": {
    "AUTH_API_URL": "https://api.auth.alrevion.com",
    // Выделенная bot-only группа Telegram под вложения -- единственное
    // хранилище медиа (ADR-4). Бот @hando_ai_bot уже добавлен в неё.
    // Валидируется через resolveChatId при настройке.
    "TELEGRAM_STORAGE_CHAT_ID": "-5572663778",
    // Пусто до создания первого пользователя в базе Hando: id из базы Sayn
    // здесь бессмысленен. MCP не заработает, пока не заполнено.
    "MCP_USER_ID": "",
    // Организация, на которую заперт /mcp (решение шага 2a). Совпадает с
    // пилотной из миграции 0010. Пустое значение = отказ, а не «пропускаем всё».
    "MCP_ORG_ID": "org-pilot",
    // Модели Groq -- vars, а не секреты: имена не конфиденциальны, а менять их
    // без выкладки кода полезно. Ключ GROQ_API_KEY -- секрет.
    "GROQ_STT_MODEL": "whisper-large-v3-turbo",
    "GROQ_LLM_MODEL": "openai/gpt-oss-120b"
  }
}
